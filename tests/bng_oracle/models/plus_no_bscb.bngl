# The `+` between product patterns holds whatever block_same_complex_binding
# says (issue #123).
#
# -bscb is NFsim's switch for whether one complex may supply both reactant
# patterns of a bimolecular rule; RuleMonkey's -no-bscb turns it off for
# parity with NFsim runs that omit it. RuleMonkey 3.12.0 also let the same
# switch decide whether a rule's products have to come apart, so under
# -no-bscb a rule whose `+` could not hold fired anyway. BioNetGen's network
# has no such switch: it generates no reaction for a `+` that cannot hold.
# check.py runs this model with -no-bscb, against BNG2's own network.
#
# Four channels, no molecule type shared between them. In each, rings that
# the rule cannot part sit beside linear complexes it can, so a fix that
# stopped the rule altogether fails as surely as the defect does.
#
#   Split  `L(r!1).R(l!1) -> L(r) + R(l)` on L.R.L.R rings and L.R dimers.
#          Breaking one bond of a ring leaves L and R joined the other way
#          round, so BNG2 splits only the dimers. 3.12.0 opened every ring.
#   Grab   the same with two reactant patterns and a bond made:
#          `L2(r!1,c).R2(l!1) + C(x) -> L2(r,c!2).C(x!2) + R2(l)`.
#          3.12.0 bound a C to every ring.
#   Del    `A(b!1).B(a!1,c!2).C(b!2) -> A(b) + C(b) DeleteMolecules`, which
#          deletes B, on A.B.C rings that an A-C bond keeps whole and on
#          A.B.C chains it does not. This shape takes the engine's full
#          post-reaction split (issue #104). 3.12.0 deleted every ring's B.
#   Apart  `Pa(s~0).Pb(t~0) -> Pa(s~1) + Pb(t~1)`, which writes two bonded
#          molecules into different product patterns and deletes nothing.
#          BNG2 generates no reaction for it (issue #105) and the load warns.
#          3.12.0 fired it at k under -no-bscb.
#
# The SSA reference is for Grab, whose C pool depletes as it binds; the
# other channels are first order, where the ODE would serve as well.

begin model
begin parameters
  k_split  1
  k_grab   0.01
  k_del    0.5
  k_apart  1
  N        100
end parameters

begin molecule types
  L(r,r)
  R(l,l)
  L2(r,r,c)
  R2(l,l)
  C(x)
  Ad(b,c)
  Bd(a,c)
  Cd(b,a)
  Pa(s~0~1,b)
  Pb(t~0~1,a)
end molecule types

begin seed species
  L(r!1,r!2).R(l!2,l!3).L(r!3,r!4).R(l!4,l!1)          N
  L(r!1,r).R(l!1,l)                                    N
  L2(r!1,r!2,c).R2(l!2,l!3).L2(r!3,r!4,c).R2(l!4,l!1)  N
  L2(r!1,r,c).R2(l!1,l)                                N
  C(x)                                                 2*N
  Ad(b!1,c!3).Bd(a!1,c!2).Cd(b!2,a!3)                  N
  Ad(b!1,c).Bd(a!1,c!2).Cd(b!2,a)                      N
  Pa(s~0,b!1).Pb(t~0,a!1)                              N
end seed species

begin observables
  Species   Split_rings  L(r!1,r!2).R(l!2,l!3).L(r!3,r!4).R(l!4,l!1)
  Species   Split_free_L L(r,r)
  Species   Grab_rings   L2(r!1,r!2).R2(l!2,l!3).L2(r!3,r!4).R2(l!4,l!1)
  Molecules Grab_free_C  C(x)
  Molecules Del_B        Bd()
  Molecules Apart_on     Pa(s~1)
end observables

begin reaction rules
  Split: L(r!1).R(l!1) -> L(r) + R(l)  k_split
  Grab:  L2(r!1,c).R2(l!1) + C(x) -> L2(r,c!2).C(x!2) + R2(l)  k_grab
  Del:   Ad(b!1).Bd(a!1,c!2).Cd(b!2) -> Ad(b) + Cd(b)  k_del  DeleteMolecules
  Apart: Pa(s~0).Pb(t~0) -> Pa(s~1) + Pb(t~1)  k_apart
end reaction rules
end model

begin actions
  writeXML({overwrite=>1})
end actions
