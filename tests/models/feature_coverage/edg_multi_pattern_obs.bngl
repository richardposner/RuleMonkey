# Edge case: observable with MANY alternative patterns (sum of matches)
# Tests:  a single Observable can carry multiple Patterns (comma-
#         separated in BNGL).  BOTH types sum across the patterns rather
#         than merging them: Molecules adds each pattern's embedding
#         count and Species adds each pattern's species count, so a
#         complex that two patterns match is counted once per pattern.
#         ft_local_functions already uses 2-pattern observables; this
#         model goes wider (5 patterns per observable, two observables)
#         and crosses molecule-type boundaries within one observable.
#         Hits Observable::patterns iteration in the incremental update
#         and, since issue #81, the per-pattern per-complex tally the
#         Species tracker keeps.
# Edge:   One pattern (`A(s!+,t!+)`) is a strict subset of another
#         (`A(s!+)`), and all three of `HetSpec`'s patterns match an
#         A.B or A.C dimer.  Overlap is the point, and the reference
#         settles which way it resolves: at t=0.5 it reports B bound
#         11.4, C bound 11.6, A doubly bound 4.6 and HetSpec 34.40 --
#         which is the sum 11.4 + 11.4 + 11.6, not the merge
#         11.4 + 11.6 - 4.6 = 18.40, and the two stay that far apart for
#         the whole run.  An earlier revision of this header called the
#         Species case a union; it is not, and the double count it
#         called a regression is the semantics.
# Tier:   base
# invariant: conserved A_total = 30

begin model
begin parameters
    A_tot   30
    B_tot   30
    C_tot   30
    kf1     0.05
    kr1     0.10
    kf2     0.04
    kr2     0.08
end parameters

begin molecule types
    A(s,t,p~U~P)
    B(a)
    C(a)
end molecule types

begin seed species
    A(s,t,p~U)   A_tot
    B(a)         B_tot
    C(a)         C_tot
end seed species

begin observables
    # Molecules: sum of embedding counts.  A(s!+) and A(s!+,t!+) overlap
    # by design — A doubly bound counts twice in this observable.
    Molecules  AnyBound   A(s!+), A(t!+), A(s!+,t!+), B(a!+), C(a!+)
    # Species: union of species matching ANY listed pattern.
    Species    HetSpec    A(s!+), B(a!+), C(a!+)
    # Cross-molecule-type Molecules observable mixing 5 patterns.
    Molecules  Anything   A(p~U), A(p~P), B(a), B(a!+), C()
    # Plain reference observables.
    Molecules  A_total    A()
    Molecules  B_free     B(a)
    Molecules  C_free     C(a)
    Molecules  A_doubly   A(s!+,t!+)
end observables

begin reaction rules
    A(s) + B(a) <-> A(s!1).B(a!1)  kf1, kr1
    A(t) + C(a) <-> A(t!1).C(a!1)  kf2, kr2
    # Background phospho keeps p~P populated.
    A(p~U) -> A(p~P)  0.02
end reaction rules
end model

begin actions
simulate({method=>"nf",t_end=>30,n_steps=>60})
end actions
