# Fixture for late_start_test (issue #110): A(s~0) -> A(s~1) at a constant
# k, so no rule reads the clock and every waiting time is added on the SSA's
# plain path.  The count of A0 at t_start + d is binomial with mean
# N0*exp(-k*d), whatever t_start is.  clock() is an output function only:
# it reads time() at each sample without making the rule clock-driven.
begin model
begin parameters
  k   0.5
  N0  1e4
end parameters
begin molecule types
  A(s~0~1)
end molecule types
begin seed species
  A(s~0)  N0
end seed species
begin observables
  Molecules A0 A(s~0)
end observables
begin functions
  clock() = time()
end functions
begin reaction rules
  A(s~0) -> A(s~1)  k
end reaction rules
end model
begin actions
  writeXML()
end actions
