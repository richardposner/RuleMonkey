# Fixture for time_dependent_rate_test (issue #86): one zero-order rule whose
# rate reads the clock and nothing else, so no other event can refresh it.
# The four parameters select a shape; the test sets them with set_param.
# Each shape the test uses puts the integrated rate at Lambda(2) = 200.
#
#   ramp   a=100        f = 100*t            0 at t = 0    Lambda = 50 t^2
#   small  a=100 b=0.1  f = 100*t + 0.1      small at 0    Lambda = 50 t^2 + 0.1 t
#   dip    c=300        f = 300*(t-1)^2      0 at t = 1    Lambda = 100((t-1)^3 + 1)
#   step   d=200        f = 200 for t > 1    0 up to t = 1 Lambda = 200 max(0, t-1)
#   pulse  e=20000      f = 20000 on (1, 1.01), else 0  Lambda = 20000 clamp(t-1, 0, 0.01)
#
# clock() is an output function, read back at each sample.
begin model
begin parameters
  a 100
  b 0
  c 0
  d 0
  e 0
end parameters
begin molecule types
  B()
end molecule types
begin seed species
  B() 0
end seed species
begin observables
  Molecules Btot B()
end observables
begin functions
  f() = a*time() + b + c*(time()-1)^2 + if(time()>1, d, 0) + if(time()>1, if(time()<1.01, e, 0), 0)
  clock() = time()
end functions
begin reaction rules
  0 -> B() f()
end reaction rules
end model
begin actions
  writeXML()
end actions
