begin model
begin parameters
  k 1.0e-6
end parameters
begin molecule types
  A(s)
  P()
end molecule types
begin seed species
  A(s) 400
end seed species
begin observables
  Molecules A_free A(s)
  Molecules P_made P()
end observables
begin reaction rules
  r: A(s) + A(s) + A(s) -> P()  k  DeleteMolecules
end reaction rules
end model
begin actions
  writeXML()
end actions
