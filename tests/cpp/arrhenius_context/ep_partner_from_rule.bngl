# Issue #109: a context site whose second partner only a rule makes.  No seed
# species holds A's c bound to D, but Dbind can bind it, so
# A(b!1,c!2).B(a!1).C(a!2) cannot be read as "A's c is bound".  The Arrhenius
# rule must be refused.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
  G_C -1
  kd 1
end parameters
begin molecule types
  A(b,c)
  B(a)
  C(a)
  D(a)
end molecule types
begin seed species
  A(b!1,c!2).B(a!1).C(a!2) 1000
  A(b!1,c).B(a!1) 1000
  D(a) 1000
end seed species
begin energy patterns
  A(b!1).B(a!1) G_AB
  A(b!1,c!2).B(a!1).C(a!2) G_C
end energy patterns
begin observables
  Species ABC A(b!1,c!2).B(a!1).C(a!2)
  Species ABD A(b!1,c!2).B(a!1).D(a!2)
end observables
begin reaction rules
  Unbind: A(b!1).B(a!1) -> A(b) + B(a) Arrhenius(phi,Ea0)
  Dbind: A(c) + D(a) -> A(c!1).D(a!1) kd
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
