# Issue #109: the rule-context checks besides case 9's state.  RuleMonkey
# builds each rule it expands from an Arrhenius rule out of the two bond sites
# alone, so a rule whose reactant pattern asks for anything more must be
# refused.  Each rule runs on molecule types of its own, under a plain-pair
# energy pattern the expansion prices exactly, so each trips one check:
#   Extra    a third molecule in the reactant pattern
#   Free     a site the reactant pattern requires free (unbinding)
#   Bound    a site the reactant pattern requires bound (binding)
#   Dot      an unbinding written with `.` between its products, which BNG2
#            fires only where the bond does not part the complex
#   Ok       control: a `!?` site asks nothing, so the rule expands
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G -2
end parameters
begin molecule types
  A1(b)
  B1(a,c)
  C1(a)
  A2(b,c)
  B2(a)
  A3(b)
  B3(a)
  A4(b,c)
  B4(a)
  X4(a)
  A5(b,c)
  B5(a)
end molecule types
begin seed species
  A1(b!1).B1(a!1,c!2).C1(a!2) 100
  A2(b!1,c).B2(a!1) 100
  A3(b!1).B3(a!1) 100
  A4(b,c!1).X4(a!1) 100
  B4(a) 100
  A5(b,c) 100
  B5(a) 100
end seed species
begin energy patterns
  A1(b!1).B1(a!1) G
  A2(b!1).B2(a!1) G
  A3(b!1).B3(a!1) G
  A4(b!1).B4(a!1) G
  A5(b!1).B5(a!1) G
end energy patterns
begin reaction rules
  Extra: A1(b!1).B1(a!1,c!2).C1(a!2) -> A1(b) + B1(a,c!2).C1(a!2) Arrhenius(phi,Ea0)
  Free:  A2(b!1,c).B2(a!1) -> A2(b,c) + B2(a) Arrhenius(phi,Ea0)
  Bound: A4(b,c!+) + B4(a) -> A4(b!1,c!+).B4(a!1) Arrhenius(phi,Ea0)
  Dot:   A3(b!1).B3(a!1) -> A3(b).B3(a) Arrhenius(phi,Ea0)
  Ok:    A5(b,c!?) + B5(a) -> A5(b!1,c!?).B5(a!1) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
