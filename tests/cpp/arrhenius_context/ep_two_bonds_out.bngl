# Issue #109, case 7: energy-pattern context two bonds out.
# A(b!1).B(a!1,c!2).C(b!2,d!3).D(c!3) applies only where C also holds a D;
# RuleMonkey's load-time expansion checks only B's c.  The rule must be
# refused.
#   A.B.C.D: dG = -(G_AB + G_D) = 3 -> 0.2865;  A.B.C (C's d free): 0.4066
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
  G_D -1
end parameters
begin molecule types
  A(b)
  B(a,c)
  C(b,d)
  D(c)
end molecule types
begin seed species
  A(b!1).B(a!1,c!2).C(b!2,d!3).D(c!3) 1000
  A(b!1).B(a!1,c!2).C(b!2,d) 1000
end seed species
begin energy patterns
  A(b!1).B(a!1) G_AB
  A(b!1).B(a!1,c!2).C(b!2,d!3).D(c!3) G_D
end energy patterns
begin observables
  Species ABCD A(b!1).B(a!1,c!2).C(b!2,d!+)
  Species ABC A(b!1).B(a!1,c!2).C(b!2,d)
end observables
begin reaction rules
  Unbind: A(b!1).B(a!1) -> A(b) + B(a) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
