# An Arrhenius rule on the exact path (issue #109) in a model with no energy
# patterns at all: its reactant pattern carries context, so it runs as
# itself, and with nothing to count its dG is 0 and its rate exp(-Ea0).
begin model
begin parameters
  Ea0 0.5
  phi 0.35
end parameters
begin molecule types
  A(b,s~0~1)
  B(a)
end molecule types
begin seed species
  A(b!1,s~1).B(a!1) 1000
  A(b!1,s~0).B(a!1) 1000
end seed species
begin observables
  Molecules AB1 A(b!1,s~1).B(a!1)
  Molecules AB0 A(b!1,s~0).B(a!1)
end observables
begin reaction rules
  Unbind: A(b!1,s~1).B(a!1) -> A(b,s~1) + B(a) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
