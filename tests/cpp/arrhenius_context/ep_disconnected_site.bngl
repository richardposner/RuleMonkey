# An energy pattern joined only by `.` that asks something of a bond site,
# A(x).C(), beside an unbinding written with `.`: the rule never parts a
# complex, but it frees A's x, which the pattern requires free, so it does
# change the pattern's count, and the exact path cannot count it.  The rule
# must be refused (issue #109).
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
  G_d 2
end parameters
begin molecule types
  A(x,c)
  B(y,d)
  C(a,b)
end molecule types
begin seed species
  A(x!1,c!2).B(y!1,d!3).C(a!2,b!3) 100
end seed species
begin energy patterns
  A(x!1).B(y!1) G_AB
  A(x).C() G_d
end energy patterns
begin observables
  Molecules AB A(x!1).B(y!1)
end observables
begin reaction rules
  Open: A(x!1).B(y!1) -> A(x).B(y) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
