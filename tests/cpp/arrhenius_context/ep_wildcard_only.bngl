# Issue #109, case 3: an energy pattern written with wildcard bonds only.
# L(r!+,r!+) loses a match whenever a bond of a doubly bound L breaks, but it
# names no bond, so RuleMonkey's load-time expansion never sees it.  The rule
# must be refused.
# BNG2: each of the two bonds of L(r!1,r!2).R(l!1).R(l!2) breaks at
#   exp(-(Ea0 + phi*(-(G_LR+G_full)))) = exp(-(0.2+0.35*3)) = 0.2865
# so the doubly bound count decays at 2*0.2865 = 0.573.
# Without the wildcard pattern: 2*exp(-(0.2+0.35*2)) = 0.813.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_LR -2
  G_full -1
end parameters
begin molecule types
  L(r,r)
  R(l)
  X()
end molecule types
begin seed species
  L(r!1,r!2).R(l!1).R(l!2) 1000
  X() 1
end seed species
begin energy patterns
  L(r!1).R(l!1) G_LR
  L(r!+,r!+) G_full
end energy patterns
begin observables
  Species AB1 L(r!+,r!+)
  Molecules AB0 X()
end observables
begin reaction rules
  Unbind: L(r!1).R(l!1) -> L(r) + R(l) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
