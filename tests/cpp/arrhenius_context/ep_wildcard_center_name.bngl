# Issue #109, case 4: a wildcard context site named like the reaction site.
# L(r!1,r!+).R(l!1) needs the OTHER r bound, so it does not apply to a singly
# bound L; RuleMonkey's load-time expansion applies it anyway.  The rule must
# be refused.
# BNG2 rate exp(-(Ea0+phi*(-G_LR))) = exp(-0.9) = 0.4066.
# If applied anyway: exp(-(0.2+0.35*3)) = 0.2865.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_LR -2
  G_full -1
end parameters
begin molecule types
  L(r,r)
  R(l)
end molecule types
begin seed species
  L(r!1,r).R(l!1) 1000
end seed species
begin energy patterns
  L(r!1).R(l!1) G_LR
  L(r!1,r!+).R(l!1) G_full
end energy patterns
begin observables
  Species AB1 L(r!+)
  Molecules AB0 R(l)
end observables
begin reaction rules
  Unbind: L(r!1).R(l!1) -> L(r) + R(l) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
