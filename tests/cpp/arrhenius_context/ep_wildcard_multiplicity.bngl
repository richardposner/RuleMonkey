# Issue #109: a `!?` that can land more than one way.  L declares three r
# sites, so L(r!1,r!?).R(l!1) matches each L-R bond twice, once per other r,
# and BioNetGen counts its energy twice per bond.  RuleMonkey's load-time
# expansion counts it once.  The rule must be refused.
#   BNG2: each R unbinds at exp(-(Ea0 + phi*(-(G_LR + 2*G_W)))) = exp(-1.6)
#   counted once: exp(-(0.2 + 0.35*3)) = exp(-1.25)
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_LR -2
  G_W -1
end parameters
begin molecule types
  L(r,r,r)
  R(l)
end molecule types
begin seed species
  L(r!1,r,r).R(l!1) 1000
end seed species
begin energy patterns
  L(r!1).R(l!1) G_LR
  L(r!1,r!?).R(l!1) G_W
end energy patterns
begin observables
  Molecules LR L(r!1).R(l!1)
end observables
begin reaction rules
  Unbind: L(r!1).R(l!1) -> L(r) + R(l) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
