# Issue #109, case 8: two context bonds in one energy pattern.
# A(b!1,c!2,d!3).B(a!1).C(a!2).D(a!3) needs both c and d bound; RuleMonkey's
# load-time expansion applies it when either is.  The rule must be refused.
#   A.B.C.D: dG = -(G_AB + G_CD) = 3 -> exp(-(0.2+0.35*3)) = 0.2865
#   A.B.C (d free), A.B.D (c free): dG = 2 -> exp(-0.9) = 0.4066
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
  G_CD -1
end parameters
begin molecule types
  A(b,c,d)
  B(a)
  C(a)
  D(a)
end molecule types
begin seed species
  A(b!1,c!2,d!3).B(a!1).C(a!2).D(a!3) 1000
  A(b!1,c!2,d).B(a!1).C(a!2) 1000
end seed species
begin energy patterns
  A(b!1).B(a!1) G_AB
  A(b!1,c!2,d!3).B(a!1).C(a!2).D(a!3) G_CD
end energy patterns
begin observables
  Species ABCD A(b!1,c!+,d!+).B(a!1)
  Species ABC A(b!1,c!+,d).B(a!1)
end observables
begin reaction rules
  Unbind: A(b!1).B(a!1) -> A(b) + B(a) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
