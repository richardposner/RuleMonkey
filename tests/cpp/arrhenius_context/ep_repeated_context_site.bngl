# Issue #109: a context site its molecule type declares twice.  A has two c
# sites, so A(x!1,c!2).B(y!1).C(a!2) matches once per bound c.  RuleMonkey's
# load-time expansion adds one "c bound" or "c free" condition to the rule it
# builds, which an A with one c of each kind matches both ways.  The rule must
# be refused.  Unidirectional unbinding of B:
#   one C : dG = -(G_AB + G_C)   = 3 -> exp(-(0.2+0.35*3)) = exp(-1.25)
#   two C : dG = -(G_AB + 2 G_C) = 4 -> exp(-(0.2+0.35*4)) = exp(-1.6)
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
  G_C -1
end parameters
begin molecule types
  A(x,c,c)
  B(y)
  C(a)
end molecule types
begin seed species
  A(x!1,c!2,c).B(y!1).C(a!2) 1000
  A(x!1,c!2,c!3).B(y!1).C(a!2).C(a!3) 1000
end seed species
begin energy patterns
  A(x!1).B(y!1) G_AB
  A(x!1,c!2).B(y!1).C(a!2) G_C
end energy patterns
begin observables
  Species AB1 A(x!1,c!+,c).B(y!1)
  Species AB2 A(x!1,c!+,c!+).B(y!1)
end observables
begin reaction rules
  Unbind: A(x!1).B(y!1) -> A(x) + B(y) Arrhenius(phi,Ea0)
end reaction rules
end model
begin actions
  writeXML({overwrite=>1})
end actions
