              <AllowedState id="0"/>
              <AllowedState id="1"/>
            </ListOfAllowedStates>
          </ComponentType>
          <ComponentType id="t">
            <ListOfAllowedStates>
              <AllowedState id="a"/>
              <AllowedState id="b"/>
            </ListOfAllowedStates>
          </ComponentType>
        </ListOfComponentTypes>
      </MoleculeType>
      <MoleculeType id="Q">
