          <ComponentType id="u">
            <ListOfAllowedStates>
              <AllowedState id="x"/>
              <AllowedState id="y"/>
            </ListOfAllowedStates>
          </ComponentType>
        </ListOfComponentTypes>
      </MoleculeType>
      <MoleculeType id="R"/>
    </ListOfMoleculeTypes>
    <ListOfCompartments>
    </ListOfCompartments>
    <ListOfSpecies>
      <Species id="S1"  concentration="nP" name="P(t~b,s~0,s~1)">
        <ListOfMolecules>
          <Molecule id="S1_M1" name="P">
            <ListOfComponents>
              <Component id="S1_M1_C1" name="t" state="b" numberOfBonds="0"/>
              <Component id="S1_M1_C2" name="s" state="0" numberOfBonds="0"/>
