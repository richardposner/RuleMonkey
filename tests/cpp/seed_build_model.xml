    <ListOfParameters>
      <Parameter id="nP" type="Constant" value="3" expr="3"/>
      <Parameter id="nD" type="Constant" value="4" expr="4"/>
      <Parameter id="nQ" type="Constant" value="0" expr="0"/>
      <Parameter id="koff" type="Constant" value="0.5" expr="0.5"/>
      <Parameter id="kflip" type="Constant" value="0.3" expr="0.3"/>
      <Parameter id="ksyn" type="Constant" value="2" expr="2.0"/>
    </ListOfParameters>
    <ListOfMoleculeTypes>
