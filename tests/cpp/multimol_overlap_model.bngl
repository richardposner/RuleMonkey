begin model
begin parameters
  k 0.05
end parameters
begin molecule types
  A(s,d)
  P()
end molecule types
begin seed species
  A(s,d!1).A(s,d!1) 5
end seed species
begin observables
  Molecules A_tot A()
  Molecules P_made P()
end observables
begin reaction rules
  r: A(s,d!1).A(s,d!1) + A(s) -> P()  k  DeleteMolecules
end reaction rules
end model
begin actions
  writeXML()
end actions
