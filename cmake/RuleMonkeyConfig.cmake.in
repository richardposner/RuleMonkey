@PACKAGE_INIT@

# RuleMonkey package config — see top-level CMakeLists.txt for the
# install layout this consumes.
#
# Usage in a host project:
#   find_package(RuleMonkey 3.1 CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE RuleMonkey::rulemonkey)

# librulemonkey.a links Threads::Threads (run_ensemble, issue #113), so the
# exported target names it and it must be found before the targets load.
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/RuleMonkeyTargets.cmake")

check_required_components(RuleMonkey)
